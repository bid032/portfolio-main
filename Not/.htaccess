# Force HTTP 503 Service Unavailable for Maintenance (SEO Protection for Googlebot)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteCond %{REQUEST_URI} !^/index\.php$
  RewriteCond %{REQUEST_URI} !\.(png|jpg|jpeg|gif|css|js|svg|ico|webp)$ [NC]
  RewriteRule ^(.*)$ /index.html [R=503,L]
</IfModule>

ErrorDocument 503 /index.html

<IfModule mod_headers.c>
  Header always set Retry-After "86400"
</IfModule>
