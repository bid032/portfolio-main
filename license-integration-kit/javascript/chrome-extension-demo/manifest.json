{
  "manifest_version": 3,
  "name": "My Licensed Chrome Extension",
  "version": "1.0.0",
  "description": "Example Chrome Extension protected by Bid032 Store License Key System.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://bid032.com/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Extension License Status"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["license-client.js", "content.js"]
    }
  ]
}
